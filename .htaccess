# EARTHSCOPE shared-hosting defaults. Avoid non-portable directives that cause HTTP 500.
DirectoryIndex index.php

<IfModule mod_authz_core.c>
  <FilesMatch "^(config\.php|config\.local\.php|config\.local\.php\.example|README.*|TEST_REPORT.*\.md|SOURCES_AND_LIMITS\.md|DEMO_RUNBOOK\.md|DEPLOYMENT_CHECKLIST\.md|PROJECT_DOCUMENTATION\.md|CHANGELOG_.*\.md|FEATURE_MATRIX.*\.md)$">
    Require all denied
  </FilesMatch>
  <FilesMatch "^(health\.php)$">
    Require all granted
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "^(config\.php|config\.local\.php|config\.local\.php\.example|README.*|TEST_REPORT.*\.md|SOURCES_AND_LIMITS\.md|DEMO_RUNBOOK\.md|DEPLOYMENT_CHECKLIST\.md|PROJECT_DOCUMENTATION\.md|CHANGELOG_.*\.md|FEATURE_MATRIX.*\.md)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^storage/ - [F,L]
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(self), microphone=(self), camera=(self)"
</IfModule>
